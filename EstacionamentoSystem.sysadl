Model SysADLModel ;

// =====================================================================
//  SISTEMA DE GESTAO E CONTROLE DE ESTACIONAMENTO - versao AQ2026_2
//
//  Pacotes:
//    SysADL.types               -> tipos de dados
//    EstacionamentoPorts        -> portas simples e a porta composta de consulta
//    EstacionamentoConnectors   -> conectores simples e o conector composto
//    EstacionamentoComponents   -> componentes simples (dispositivos,
//                                  controladores e banco de dados)
//    EstacionamentoModulos      -> modulos compostos + sistema raiz
//
//  Hierarquia:
//    SistemaEstacionamentoCP (raiz, sem portas)
//      |- entrada       : ModuloEntradaCP
//      |- saida         : ModuloSaidaCP
//      |- pagamento     : ModuloPagamentoCP
//      |- vagas         : ModuloVagasCP
//      |- administracao : ModuloAdministracaoCP
//      |- bancoDados    : BancoDadosCP (caixa-preta)
//
//  Regra geral: cada modulo tem dispositivos (boundary) que so captam
//  ou atuam, e UM controlador que toma as decisoes do modulo.
// =====================================================================


package SysADL.types {

    // Tipos primitivos
    value type Int { }
    value type Boolean { }
    value type String { }
    value type Void { }
    value type Real { }

    // Dimensoes e unidades
    dimension Data
    unit DataUnit { dimension = Data }
    value type DataType { dimension = Data }

    dimension Horario
    unit HorarioStandardTime
    value type HorarioStandardTimeType {
        unit = HorarioStandardTime
        dimension = Horario
    }

    dimension Tempo
    unit TempoStandard
    value type Duration {
        unit = TempoStandard
        dimension = Tempo
    }

    dimension Moeda
    unit MoedaBRL
    value type Money {
        unit = MoedaBRL
        dimension = Moeda
    }

    // Enumeracoes
    enum ComandoCancela {
        Abrir ,
        Fechar
    }

    enum ComandoEmergencia {
        Ativar ,
        Desativar
    }

    enum DeteccaoVeiculo {
        Presenca ,
        Ausente
    }

    enum StatusPagamento {
        NaoPago ,
        PagoDentroTolerancia ,
        PagoToleranciaExpirada
    }

    enum TipoOperacao {
        Publico ,
        Privado
    }

    // Tipos basicos
    datatype Placa {
        attributes :
            valor : String ;
    }

    datatype QRCode {
        attributes :
            codigo : String ;
    }

    datatype DataHorario {
        attributes :
            data : DataType ;
            hora : HorarioStandardTimeType ;
    }

    // Entrada e saida
    datatype InformacoesEntrada {
        attributes :
            placa   : Placa ;
            horario : DataHorario ;
    }

    // Ticket = sessao do veiculo, criada na entrada
    datatype Ticket {
        attributes :
            id             : String ;
            qrCode         : QRCode ;
            placa          : Placa ;
            horarioEntrada : DataHorario ;
    }

    datatype InformacoesSaida {
        attributes :
            ticketId : String ;
            placa    : Placa ;
            horario  : DataHorario ;
    }

    // Vagas e monitoramento
    datatype Vaga {
        attributes :
            id     : String ;
            status : DeteccaoVeiculo ;
    }

    datatype ControleVagas {
        attributes :
            vagasOcupadas : Int ;
            vagasLivres   : Int ;
            lotado        : Boolean ;
            entradasDia   : Int ;
            saidasDia     : Int ;
    }

    datatype EstatisticasOperacionais {
        attributes :
            taxaOcupacao : Real ;
            vagasLivres  : Int ;
            entradasDia  : Int ;
            saidasDia    : Int ;
    }

    // Configuracao
    datatype ConfiguracaoEstacionamento {
        attributes :
            capacidade          : Int ;
            tipoOperacao        : TipoOperacao ;
            tarifaPorHora       : Money ;
            toleranciaPagamento : Duration ;
    }

    // Consulta de sessao ao banco (por QR Code ou por placa)
    datatype ConsultaSessao {
        attributes :
            qrCode : QRCode ;
            placa  : Placa ;
    }

    datatype SessaoEstacionamento {
        attributes :
            encontrada      : Boolean ;
            ticket          : Ticket ;
            statusPagamento : StatusPagamento ;
            valorPago       : Money ;
            limiteSaida     : DataHorario ;
    }

    // Pagamento
    datatype CalculoTarifa {
        attributes :
            ticketId         : String ;
            tempoPermanencia : Duration ;
            valorDevido      : Money ;
    }

    datatype EfetuarPagamento {
        attributes :
            ticketId : String ;
            valor    : Money ;
    }

    datatype RegistroPagamento {
        attributes :
            ticketId         : String ;
            valorPago        : Money ;
            horarioPagamento : DataHorario ;
            limiteSaida      : DataHorario ;
            status           : StatusPagamento ;
    }

    datatype Comprovante {
        attributes :
            ticketId         : String ;
            placa            : Placa ;
            horarioEntrada   : DataHorario ;
            horarioPagamento : DataHorario ;
            valorPago        : Money ;
            limiteSaida      : DataHorario ;
    }
}


package EstacionamentoPorts {
    import SysADL.types ;

    // =================== PORTAS SIMPLES (IPT = entrada, OPT = saida) ===================

    port def PlacaIPT { flow in Placa }
    port def PlacaOPT { flow out Placa }

    port def QRCodeIPT { flow in QRCode }
    port def QRCodeOPT { flow out QRCode }

    port def DeteccaoVeiculoIPT { flow in DeteccaoVeiculo }
    port def DeteccaoVeiculoOPT { flow out DeteccaoVeiculo }

    port def VagaIPT { flow in Vaga }
    port def VagaOPT { flow out Vaga }

    port def ComandoCancelaIPT { flow in ComandoCancela }
    port def ComandoCancelaOPT { flow out ComandoCancela }

    port def ComandoEmergenciaIPT { flow in ComandoEmergencia }
    port def ComandoEmergenciaOPT { flow out ComandoEmergencia }

    port def InformacoesEntradaIPT { flow in InformacoesEntrada }
    port def InformacoesEntradaOPT { flow out InformacoesEntrada }

    port def InformacoesSaidaIPT { flow in InformacoesSaida }
    port def InformacoesSaidaOPT { flow out InformacoesSaida }

    port def TicketIPT { flow in Ticket }
    port def TicketOPT { flow out Ticket }

    port def ControleVagasIPT { flow in ControleVagas }
    port def ControleVagasOPT { flow out ControleVagas }

    port def EstatisticasOperacionaisIPT { flow in EstatisticasOperacionais }
    port def EstatisticasOperacionaisOPT { flow out EstatisticasOperacionais }

    port def ConfiguracaoEstacionamentoIPT { flow in ConfiguracaoEstacionamento }
    port def ConfiguracaoEstacionamentoOPT { flow out ConfiguracaoEstacionamento }

    port def ConsultaSessaoIPT { flow in ConsultaSessao }
    port def ConsultaSessaoOPT { flow out ConsultaSessao }

    port def SessaoEstacionamentoIPT { flow in SessaoEstacionamento }
    port def SessaoEstacionamentoOPT { flow out SessaoEstacionamento }

    port def CalculoTarifaIPT { flow in CalculoTarifa }
    port def CalculoTarifaOPT { flow out CalculoTarifa }

    port def EfetuarPagamentoIPT { flow in EfetuarPagamento }
    port def EfetuarPagamentoOPT { flow out EfetuarPagamento }

    port def RegistroPagamentoIPT { flow in RegistroPagamento }
    port def RegistroPagamentoOPT { flow out RegistroPagamento }

    port def ComprovanteIPT { flow in Comprovante }
    port def ComprovanteOPT { flow out Comprovante }

    // =================== PORTA COMPOSTA (consulta ao banco) ===================
    // O2I = lado de quem pergunta (envia a consulta, recebe a sessao)
    // I2O = lado do banco (recebe a consulta, devolve a sessao)

    port def ConsultaSessaoO2I {
        ports :
            consultaSessaoEnv : ConsultaSessaoOPT ;
            sessaoRec         : SessaoEstacionamentoIPT ;
    }

    port def ConsultaSessaoI2O {
        ports :
            consultaSessaoRec : ConsultaSessaoIPT ;
            sessaoEnv         : SessaoEstacionamentoOPT ;
    }
}


package EstacionamentoConnectors {
    import SysADL.types ;
    import EstacionamentoPorts ;

    // =================== CONECTORES SIMPLES ===================

    connector def PlacaCN {
        participants :
            ~ placaO : PlacaOPT ;
            ~ placaI : PlacaIPT ;
        flows : Placa from placaO to placaI
    }

    connector def QRCodeCN {
        participants :
            ~ qrCodeO : QRCodeOPT ;
            ~ qrCodeI : QRCodeIPT ;
        flows : QRCode from qrCodeO to qrCodeI
    }

    connector def DeteccaoVeiculoCN {
        participants :
            ~ deteccaoO : DeteccaoVeiculoOPT ;
            ~ deteccaoI : DeteccaoVeiculoIPT ;
        flows : DeteccaoVeiculo from deteccaoO to deteccaoI
    }

    connector def VagaCN {
        participants :
            ~ vagaO : VagaOPT ;
            ~ vagaI : VagaIPT ;
        flows : Vaga from vagaO to vagaI
    }

    connector def ComandoCancelaCN {
        participants :
            ~ comandoCancelaO : ComandoCancelaOPT ;
            ~ comandoCancelaI : ComandoCancelaIPT ;
        flows : ComandoCancela from comandoCancelaO to comandoCancelaI
    }

    connector def ComandoEmergenciaCN {
        participants :
            ~ emergenciaO : ComandoEmergenciaOPT ;
            ~ emergenciaI : ComandoEmergenciaIPT ;
        flows : ComandoEmergencia from emergenciaO to emergenciaI
    }

    connector def InformacoesEntradaCN {
        participants :
            ~ infoEntradaO : InformacoesEntradaOPT ;
            ~ infoEntradaI : InformacoesEntradaIPT ;
        flows : InformacoesEntrada from infoEntradaO to infoEntradaI
    }

    connector def InformacoesSaidaCN {
        participants :
            ~ infoSaidaO : InformacoesSaidaOPT ;
            ~ infoSaidaI : InformacoesSaidaIPT ;
        flows : InformacoesSaida from infoSaidaO to infoSaidaI
    }

    connector def TicketCN {
        participants :
            ~ ticketO : TicketOPT ;
            ~ ticketI : TicketIPT ;
        flows : Ticket from ticketO to ticketI
    }

    connector def ControleVagasCN {
        participants :
            ~ controleVagasO : ControleVagasOPT ;
            ~ controleVagasI : ControleVagasIPT ;
        flows : ControleVagas from controleVagasO to controleVagasI
    }

    connector def EstatisticasOperacionaisCN {
        participants :
            ~ estatisticasO : EstatisticasOperacionaisOPT ;
            ~ estatisticasI : EstatisticasOperacionaisIPT ;
        flows : EstatisticasOperacionais from estatisticasO to estatisticasI
    }

    connector def ConfiguracaoEstacionamentoCN {
        participants :
            ~ configuracaoO : ConfiguracaoEstacionamentoOPT ;
            ~ configuracaoI : ConfiguracaoEstacionamentoIPT ;
        flows : ConfiguracaoEstacionamento from configuracaoO to configuracaoI
    }

    connector def ConsultaSessaoReqCN {
        participants :
            ~ consultaO : ConsultaSessaoOPT ;
            ~ consultaI : ConsultaSessaoIPT ;
        flows : ConsultaSessao from consultaO to consultaI
    }

    connector def SessaoEstacionamentoCN {
        participants :
            ~ sessaoO : SessaoEstacionamentoOPT ;
            ~ sessaoI : SessaoEstacionamentoIPT ;
        flows : SessaoEstacionamento from sessaoO to sessaoI
    }

    connector def CalculoTarifaCN {
        participants :
            ~ tarifaO : CalculoTarifaOPT ;
            ~ tarifaI : CalculoTarifaIPT ;
        flows : CalculoTarifa from tarifaO to tarifaI
    }

    connector def EfetuarPagamentoCN {
        participants :
            ~ pagamentoO : EfetuarPagamentoOPT ;
            ~ pagamentoI : EfetuarPagamentoIPT ;
        flows : EfetuarPagamento from pagamentoO to pagamentoI
    }

    connector def RegistroPagamentoCN {
        participants :
            ~ registroO : RegistroPagamentoOPT ;
            ~ registroI : RegistroPagamentoIPT ;
        flows : RegistroPagamento from registroO to registroI
    }

    connector def ComprovanteCN {
        participants :
            ~ comprovanteO : ComprovanteOPT ;
            ~ comprovanteI : ComprovanteIPT ;
        flows : Comprovante from comprovanteO to comprovanteI
    }

    // =================== CONECTOR COMPOSTO ===================
    // Liga quem consulta (O2I) ao banco (I2O): ida = consulta, volta = sessao.
    connector def ConsultaSessaoCN {
        participants :
            ~ consultaCliente  : ConsultaSessaoO2I ;
            ~ consultaServidor : ConsultaSessaoI2O ;
        configuration {
            connectors :
                pedidoSessao   : ConsultaSessaoReqCN bindings consultaSessaoEnv = consultaSessaoRec ;
                respostaSessao : SessaoEstacionamentoCN bindings sessaoEnv = sessaoRec ;
        }
    }
}


// =====================================================================
//  COMPONENTES SIMPLES
// =====================================================================
package EstacionamentoComponents {
    import SysADL.types ;
    import EstacionamentoPorts ;

    // ---------------- Dispositivos fisicos (boundary) ----------------
    // Apenas captam dados ou executam comandos; nao tomam decisoes.

    // Camera de leitura de placa (usada na entrada e na saida)
    boundary component def CameraPlacaCP {
        ports :
            placaLida : PlacaOPT ;
    }

    // Sensor junto a cancela: garante um veiculo por vez (entrada e saida)
    boundary component def SensorPassagemCP {
        ports :
            passagem : DeteccaoVeiculoOPT ;
    }

    // Cancela (usada na entrada e na saida)
    boundary component def CancelaCP {
        ports :
            comandoCancela : ComandoCancelaIPT ;
    }

    boundary component def ImpressoraTicketCP {
        ports :
            ticketImpressao : TicketIPT ;
    }

    boundary component def LeitorQRCodeCP {
        ports :
            qrLido : QRCodeOPT ;
    }

    // Tela do totem com leitor de cartao/Pix integrado
    boundary component def InterfaceTotemCP {
        ports :
            placaDigitada        : PlacaOPT ;
            exibirTarifa         : CalculoTarifaIPT ;
            confirmacaoPagamento : EfetuarPagamentoOPT ;
            exibirComprovante    : ComprovanteIPT ;
    }

    boundary component def SensorVagaCP {
        ports :
            statusVaga : VagaOPT ;
    }

    boundary component def PainelVagasCP {
        ports :
            exibirVagas : ControleVagasIPT ;
    }

    boundary component def PainelOperadorCP {
        ports :
            exibirEstatisticas   : EstatisticasOperacionaisIPT ;
            configuracaoDefinida : ConfiguracaoEstacionamentoOPT ;
            comandoEmergenciaOp  : ComandoEmergenciaOPT ;
    }

    // ---------------- Banco de dados (boundary, caixa-preta) ----------------
    // So a interface e especificada; o funcionamento interno esta fora do escopo.
    //  ENTRA (gravacao): Ticket, RegistroPagamento, InformacoesSaida,
    //                    ConfiguracaoEstacionamento
    //  ENTRA / VOLTA   : ConsultaSessao -> SessaoEstacionamento
    boundary component def BancoDadosCP {
        ports :
            novaSessaoDB   : TicketIPT ;
            sessaoTotemDB  : ConsultaSessaoI2O ;
            sessaoSaidaDB  : ConsultaSessaoI2O ;
            pagamentoDB    : RegistroPagamentoIPT ;
            saidaDB        : InformacoesSaidaIPT ;
            configuracaoDB : ConfiguracaoEstacionamentoIPT ;
    }

    // ---------------- Controladores (um por modulo) ----------------

    // Entrada: libera se houver vaga e um veiculo por vez; gera o ticket
    component def ControladorEntradaCP {
        ports :
            placaEntrada          : PlacaIPT ;
            passagemEntrada       : DeteccaoVeiculoIPT ;
            vagasDisponiveis      : ControleVagasIPT ;
            comandoCancelaEntrada : ComandoCancelaOPT ;
            entradaRegistrada     : InformacoesEntradaOPT ;
            ticketEmitido         : TicketOPT ;
    }

    // Saida: consulta a sessao pela placa, confere a tolerancia,
    // abre a cancela (ou abre direto em emergencia) e registra a saida
    component def ControladorSaidaCP {
        ports :
            placaSaida          : PlacaIPT ;
            passagemSaida       : DeteccaoVeiculoIPT ;
            emergencia          : ComandoEmergenciaIPT ;
            consultaSessaoSaida : ConsultaSessaoO2I ;
            comandoCancelaSaida : ComandoCancelaOPT ;
            saidaRegistrada     : InformacoesSaidaOPT ;
    }

    // Pagamento: identifica a sessao (QR Code ou placa), calcula a tarifa,
    // registra o pagamento e emite o comprovante
    component def ControladorPagamentoCP {
        ports :
            qrTotem                  : QRCodeIPT ;
            placaTotem               : PlacaIPT ;
            consultaSessaoTotem      : ConsultaSessaoO2I ;
            configuracaoVigente      : ConfiguracaoEstacionamentoIPT ;
            tarifaCalculada          : CalculoTarifaOPT ;
            pagamentoRealizado       : EfetuarPagamentoIPT ;
            registroPagamentoEmitido : RegistroPagamentoOPT ;
            comprovanteEmitido       : ComprovanteOPT ;
    }

    // Vagas: conta vagas livres/ocupadas e entradas/saidas do dia
    component def GerenciadorVagasCP {
        ports :
            deteccaoVaga         : VagaIPT ;
            entradaContabilizada : InformacoesEntradaIPT ;
            saidaContabilizada   : InformacoesSaidaIPT ;
            ocupacao             : ControleVagasOPT ;
    }

    // Administracao: valida a configuracao e gera as estatisticas
    component def ControladorAdministracaoCP {
        ports :
            ocupacaoMonitorada   : ControleVagasIPT ;
            configuracaoRecebida : ConfiguracaoEstacionamentoIPT ;
            configuracaoValidada : ConfiguracaoEstacionamentoOPT ;
            estatisticasGeradas  : EstatisticasOperacionaisOPT ;
    }
}


// =====================================================================
//  MODULOS (componentes compostos) E SISTEMA RAIZ
//  Cada modulo so se comunica com o exterior pelas suas portas proxy,
//  ligadas aos componentes internos por delegations.
// =====================================================================
package EstacionamentoModulos {
    import SysADL.types ;
    import EstacionamentoPorts ;
    import EstacionamentoConnectors ;
    import EstacionamentoComponents ;

    // ---------------- MODULO DE ENTRADA ----------------
    component def ModuloEntradaCP {
        ports :
            vagasEntrada : ControleVagasIPT ;
            infoEntrada  : InformacoesEntradaOPT ;
            novaSessao   : TicketOPT ;
        configuration {
            components :
                cameraEntrada : CameraPlacaCP {
                    using ports :
                        placaLidaEntrada : PlacaOPT ;
                }
                sensorPassagemEntrada : SensorPassagemCP {
                    using ports :
                        passagemDetectadaEntrada : DeteccaoVeiculoOPT ;
                }
                cancelaEntrada : CancelaCP {
                    using ports :
                        cmdCancelaEntrada : ComandoCancelaIPT ;
                }
                impressoraTicket : ImpressoraTicketCP {
                    using ports :
                        ticketImpressao : TicketIPT ;
                }
                controladorEntrada : ControladorEntradaCP {
                    using ports :
                        placaEntrada          : PlacaIPT ;
                        passagemEntrada       : DeteccaoVeiculoIPT ;
                        vagasDisponiveis      : ControleVagasIPT ;
                        comandoCancelaEntrada : ComandoCancelaOPT ;
                        entradaRegistrada     : InformacoesEntradaOPT ;
                        ticketEmitido         : TicketOPT ;
                }
            connectors :
                placaParaControleEntrada    : PlacaCN bindings placaLidaEntrada = placaEntrada ;
                passagemParaControleEntrada : DeteccaoVeiculoCN bindings passagemDetectadaEntrada = passagemEntrada ;
                abrirCancelaEntrada         : ComandoCancelaCN bindings comandoCancelaEntrada = cmdCancelaEntrada ;
                ticketParaImpressora        : TicketCN bindings ticketEmitido = ticketImpressao ;
            delegations :
                vagasDisponiveis to vagasEntrada
                entradaRegistrada to infoEntrada
                ticketEmitido to novaSessao
        }
    }

    // ---------------- MODULO DE SAIDA ----------------
    component def ModuloSaidaCP {
        ports :
            sessaoSaida     : ConsultaSessaoO2I ;
            emergenciaSaida : ComandoEmergenciaIPT ;
            infoSaida       : InformacoesSaidaOPT ;
        configuration {
            components :
                cameraSaida : CameraPlacaCP {
                    using ports :
                        placaLidaSaida : PlacaOPT ;
                }
                sensorPassagemSaida : SensorPassagemCP {
                    using ports :
                        passagemDetectadaSaida : DeteccaoVeiculoOPT ;
                }
                cancelaSaida : CancelaCP {
                    using ports :
                        cmdCancelaSaida : ComandoCancelaIPT ;
                }
                controladorSaida : ControladorSaidaCP {
                    using ports :
                        placaSaida          : PlacaIPT ;
                        passagemSaida       : DeteccaoVeiculoIPT ;
                        emergencia          : ComandoEmergenciaIPT ;
                        consultaSessaoSaida : ConsultaSessaoO2I ;
                        comandoCancelaSaida : ComandoCancelaOPT ;
                        saidaRegistrada     : InformacoesSaidaOPT ;
                }
            connectors :
                placaParaControleSaida    : PlacaCN bindings placaLidaSaida = placaSaida ;
                passagemParaControleSaida : DeteccaoVeiculoCN bindings passagemDetectadaSaida = passagemSaida ;
                abrirCancelaSaida         : ComandoCancelaCN bindings comandoCancelaSaida = cmdCancelaSaida ;
            delegations :
                consultaSessaoSaida to sessaoSaida
                emergencia to emergenciaSaida
                saidaRegistrada to infoSaida
        }
    }

    // ---------------- MODULO DE PAGAMENTO (totem) ----------------
    component def ModuloPagamentoCP {
        ports :
            sessaoTotem       : ConsultaSessaoO2I ;
            configuracaoTotem : ConfiguracaoEstacionamentoIPT ;
            registroPagamento : RegistroPagamentoOPT ;
        configuration {
            components :
                leitorQRTotem : LeitorQRCodeCP {
                    using ports :
                        qrLido : QRCodeOPT ;
                }
                interfaceTotem : InterfaceTotemCP {
                    using ports :
                        placaDigitada        : PlacaOPT ;
                        exibirTarifa         : CalculoTarifaIPT ;
                        confirmacaoPagamento : EfetuarPagamentoOPT ;
                        exibirComprovante    : ComprovanteIPT ;
                }
                controladorPagamento : ControladorPagamentoCP {
                    using ports :
                        qrTotem                  : QRCodeIPT ;
                        placaTotem               : PlacaIPT ;
                        consultaSessaoTotem      : ConsultaSessaoO2I ;
                        configuracaoVigente      : ConfiguracaoEstacionamentoIPT ;
                        tarifaCalculada          : CalculoTarifaOPT ;
                        pagamentoRealizado       : EfetuarPagamentoIPT ;
                        registroPagamentoEmitido : RegistroPagamentoOPT ;
                        comprovanteEmitido       : ComprovanteOPT ;
                }
            connectors :
                qrParaControlePagamento    : QRCodeCN bindings qrLido = qrTotem ;
                placaParaControlePagamento : PlacaCN bindings placaDigitada = placaTotem ;
                tarifaParaTela             : CalculoTarifaCN bindings tarifaCalculada = exibirTarifa ;
                confirmarPagamento         : EfetuarPagamentoCN bindings confirmacaoPagamento = pagamentoRealizado ;
                comprovanteParaTela        : ComprovanteCN bindings comprovanteEmitido = exibirComprovante ;
            delegations :
                consultaSessaoTotem to sessaoTotem
                configuracaoVigente to configuracaoTotem
                registroPagamentoEmitido to registroPagamento
        }
    }

    // ---------------- MODULO DE VAGAS ----------------
    component def ModuloVagasCP {
        ports :
            entradasVagas : InformacoesEntradaIPT ;
            saidasVagas   : InformacoesSaidaIPT ;
            ocupacaoVagas : ControleVagasOPT ;
        configuration {
            components :
                sensorVaga : SensorVagaCP [ 1 , -1 ] {
                    using ports :
                        statusVaga : VagaOPT ;
                }
                gerenciadorVagas : GerenciadorVagasCP {
                    using ports :
                        deteccaoVaga         : VagaIPT ;
                        entradaContabilizada : InformacoesEntradaIPT ;
                        saidaContabilizada   : InformacoesSaidaIPT ;
                        ocupacao             : ControleVagasOPT ;
                }
                painelVagas : PainelVagasCP {
                    using ports :
                        exibirVagas : ControleVagasIPT ;
                }
            connectors :
                sensorParaGerenciador : VagaCN bindings statusVaga = deteccaoVaga ;
                ocupacaoParaPainel    : ControleVagasCN bindings ocupacao = exibirVagas ;
            delegations :
                entradaContabilizada to entradasVagas
                saidaContabilizada to saidasVagas
                ocupacao to ocupacaoVagas
        }
    }

    // ---------------- MODULO DE ADMINISTRACAO ----------------
    component def ModuloAdministracaoCP {
        ports :
            ocupacaoAdm     : ControleVagasIPT ;
            configuracaoAdm : ConfiguracaoEstacionamentoOPT ;
            emergenciaAdm   : ComandoEmergenciaOPT ;
        configuration {
            components :
                painelOperador : PainelOperadorCP {
                    using ports :
                        exibirEstatisticas   : EstatisticasOperacionaisIPT ;
                        configuracaoDefinida : ConfiguracaoEstacionamentoOPT ;
                        comandoEmergenciaOp  : ComandoEmergenciaOPT ;
                }
                controladorAdministracao : ControladorAdministracaoCP {
                    using ports :
                        ocupacaoMonitorada   : ControleVagasIPT ;
                        configuracaoRecebida : ConfiguracaoEstacionamentoIPT ;
                        configuracaoValidada : ConfiguracaoEstacionamentoOPT ;
                        estatisticasGeradas  : EstatisticasOperacionaisOPT ;
                }
            connectors :
                configParaControle : ConfiguracaoEstacionamentoCN bindings configuracaoDefinida = configuracaoRecebida ;
                estatParaPainel    : EstatisticasOperacionaisCN bindings estatisticasGeradas = exibirEstatisticas ;
            delegations :
                ocupacaoMonitorada to ocupacaoAdm
                configuracaoValidada to configuracaoAdm
                comandoEmergenciaOp to emergenciaAdm
        }
    }

    // ---------------- SISTEMA RAIZ (nivel 0, sem portas) ----------------
    component def SistemaEstacionamentoCP {
        configuration {
            components :
                entrada : ModuloEntradaCP {
                    using ports :
                        vagasEntrada : ControleVagasIPT ;
                        infoEntrada  : InformacoesEntradaOPT ;
                        novaSessao   : TicketOPT ;
                }
                saida : ModuloSaidaCP {
                    using ports :
                        sessaoSaida     : ConsultaSessaoO2I ;
                        emergenciaSaida : ComandoEmergenciaIPT ;
                        infoSaida       : InformacoesSaidaOPT ;
                }
                pagamento : ModuloPagamentoCP {
                    using ports :
                        sessaoTotem       : ConsultaSessaoO2I ;
                        configuracaoTotem : ConfiguracaoEstacionamentoIPT ;
                        registroPagamento : RegistroPagamentoOPT ;
                }
                vagas : ModuloVagasCP {
                    using ports :
                        entradasVagas : InformacoesEntradaIPT ;
                        saidasVagas   : InformacoesSaidaIPT ;
                        ocupacaoVagas : ControleVagasOPT ;
                }
                administracao : ModuloAdministracaoCP {
                    using ports :
                        ocupacaoAdm     : ControleVagasIPT ;
                        configuracaoAdm : ConfiguracaoEstacionamentoOPT ;
                        emergenciaAdm   : ComandoEmergenciaOPT ;
                }
                bancoDados : BancoDadosCP {
                    using ports :
                        novaSessaoDB   : TicketIPT ;
                        sessaoTotemDB  : ConsultaSessaoI2O ;
                        sessaoSaidaDB  : ConsultaSessaoI2O ;
                        pagamentoDB    : RegistroPagamentoIPT ;
                        saidaDB        : InformacoesSaidaIPT ;
                        configuracaoDB : ConfiguracaoEstacionamentoIPT ;
                }

            connectors :
                // Entre modulos
                vagasParaEntrada          : ControleVagasCN bindings ocupacaoVagas = vagasEntrada ;
                vagasParaAdm              : ControleVagasCN bindings ocupacaoVagas = ocupacaoAdm ;
                entradaParaVagas          : InformacoesEntradaCN bindings infoEntrada = entradasVagas ;
                saidaParaVagas            : InformacoesSaidaCN bindings infoSaida = saidasVagas ;
                emergenciaParaSaida       : ComandoEmergenciaCN bindings emergenciaAdm = emergenciaSaida ;
                configuracaoParaPagamento : ConfiguracaoEstacionamentoCN bindings configuracaoAdm = configuracaoTotem ;

                // Modulos -> banco de dados (gravacao)
                entradaParaBD      : TicketCN bindings novaSessao = novaSessaoDB ;
                pagamentoParaBD    : RegistroPagamentoCN bindings registroPagamento = pagamentoDB ;
                saidaParaBD        : InformacoesSaidaCN bindings infoSaida = saidaDB ;
                configuracaoParaBD : ConfiguracaoEstacionamentoCN bindings configuracaoAdm = configuracaoDB ;

                // Modulos <-> banco de dados (consulta: pedido e resposta)
                sessaoSaidaBD : ConsultaSessaoCN bindings sessaoSaida = sessaoSaidaDB ;
                sessaoTotemBD : ConsultaSessaoCN bindings sessaoTotem = sessaoTotemDB ;
        }
    }
}


// =====================================================================
//  REQUISITOS (com rastreabilidade "satisfied by")
// =====================================================================
Requirement SistemaGestaoControleEstacionamento ( 1.0 ) {
	text = "O sistema deve oferecer uma solução eficiente e segura para o gerenciamento do estacionamento, controlando o fluxo de veículos, calculando tarifas, registrando entradas e saídas e mantendo a ocupação das vagas em tempo real"
	satisfied by EstacionamentoModulos.SistemaEstacionamentoCP ;

	Requirement ConfigurarEstacionamentoFR ( 1.1 ) {
		text = "O sistema deve permitir a configuração do estacionamento: capacidade total de vagas, tipo de operação (público ou privado), tarifa por hora e tempo de tolerância após o pagamento"
		satisfied by EstacionamentoComponents.ControladorAdministracaoCP ;
	}

	Requirement ControlarEntradaSaidaFR ( 1.2 ) {
		text = "O sistema deve garantir os requisitos funcionais relacionados ao controle de entrada e saída de veículos"

		Requirement RegistrarEntradaFR ( 1.2.1 ) {
			text = "O sistema deve registrar a entrada do veículo, capturando placa e horário ao passar pela cancela de entrada"
			satisfied by EstacionamentoComponents.ControladorEntradaCP ;
		}

		Requirement GerarTicketQRCodeFR ( 1.2.2 ) {
			text = "O sistema deve gerar, na entrada, um ticket com QR Code único que representa a sessão de estacionamento do veículo"
			satisfied by EstacionamentoComponents.ControladorEntradaCP ;
		}

		Requirement RegistrarSaidaFR ( 1.2.3 ) {
			text = "O sistema deve registrar a saída do veículo, identificando a sessão pela placa lida na cancela de saída"
			satisfied by EstacionamentoComponents.ControladorSaidaCP ;
		}

		Requirement LiberarSaidaFR ( 1.2.4 ) {
			text = "O sistema deve liberar a cancela de saída somente se o pagamento estiver dentro do período de tolerância, salvo em caso de emergência"
			satisfied by EstacionamentoComponents.ControladorSaidaCP ;
		}

		Requirement ControleFluxoCancelaFR ( 1.2.5 ) {
			text = "O sistema deve garantir que apenas um veículo passe pela cancela por vez, tanto na entrada quanto na saída"
			satisfied by EstacionamentoComponents.SensorPassagemCP ;
		}

		Requirement AcionarEmergenciaFR ( 1.2.6 ) {
			text = "O operador deve poder acionar o modo de emergência, que libera a cancela de saída independentemente do pagamento"
			satisfied by EstacionamentoComponents.PainelOperadorCP ;
		}
	}

	Requirement ControlarPagamentoFR ( 1.3 ) {
		text = "O sistema deve permitir o pagamento no totem de autoatendimento por QR Code ou placa"
		satisfied by EstacionamentoModulos.ModuloPagamentoCP ;

		Requirement CalculoTarifaFR ( 1.3.1 ) {
			text = "O sistema deve calcular a tarifa com base no tempo de permanência e na tarifa por hora configurada"
			satisfied by EstacionamentoComponents.ControladorPagamentoCP ;
		}

		Requirement PagamentoQRCodeTotemFR ( 1.3.2 ) {
			text = "O sistema deve permitir o pagamento por meio da leitura do QR Code do ticket no totem"
			satisfied by EstacionamentoComponents.LeitorQRCodeCP ;
		}

		Requirement PagamentoPlacaTotemFR ( 1.3.3 ) {
			text = "O sistema deve permitir o pagamento por meio da digitação da placa do veículo no totem"
			satisfied by EstacionamentoComponents.InterfaceTotemCP ;
		}

		Requirement VisualizarPrecificacaoFR ( 1.3.4 ) {
			text = "O sistema deve exibir ao usuário o valor a ser pago antes da confirmação do pagamento"
			satisfied by EstacionamentoComponents.InterfaceTotemCP ;
		}

		Requirement EmitirComprovanteFR ( 1.3.5 ) {
			text = "Após o pagamento, o sistema deve emitir um comprovante com as informações da utilização do estacionamento"
			satisfied by EstacionamentoComponents.ControladorPagamentoCP ;
		}

		Requirement StatusPagamentoFR ( 1.3.6 ) {
			text = "O sistema deve saber o status do pagamento do ticket: não pago, pago dentro da tolerância ou pago com tolerância expirada"
			satisfied by EstacionamentoComponents.ControladorPagamentoCP ;
		}

		Requirement CobrarExcedenteToleranciaFR ( 1.3.7 ) {
			text = "Se a tolerância expirar antes da saída, o sistema deve bloquear a cancela e cobrar no totem apenas o valor excedente"
			satisfied by EstacionamentoComponents.ControladorPagamentoCP ;
			derive ControlarEntradaSaidaFR.LiberarSaidaFR ;
		}
	}

	Requirement ControlarVagasFR ( 1.4 ) {
		text = "O sistema deve manter o controle de vagas em tempo real"
		satisfied by EstacionamentoModulos.ModuloVagasCP ;

		Requirement AtualizarVagasFR ( 1.4.1 ) {
			text = "O sistema deve atualizar automaticamente vagas livres e ocupadas a cada entrada, saída ou mudança de estado de um sensor de vaga"
			satisfied by EstacionamentoComponents.GerenciadorVagasCP ;
		}

		Requirement ExibirVagasFR ( 1.4.2 ) {
			text = "O sistema deve exibir em painel o número de vagas disponíveis"
			satisfied by EstacionamentoComponents.PainelVagasCP ;
			derive AtualizarVagasFR ;
		}

		Requirement BloquearEntradaFR ( 1.4.3 ) {
			text = "O sistema deve bloquear a entrada de veículos quando não houver vagas disponíveis"
			satisfied by EstacionamentoComponents.ControladorEntradaCP ;
		}
	}

	Requirement MonitorarOperacaoFR ( 1.5 ) {
		text = "O sistema deve exibir ao operador a taxa de ocupação, as vagas livres e o número de entradas e saídas do dia"
		satisfied by EstacionamentoComponents.ControladorAdministracaoCP ;
	}

	Requirement PersistirDadosFR ( 1.6 ) {
		text = "O sistema deve registrar sessões, pagamentos, saídas e configuração em um banco de dados, que devolve a sessão correspondente a um QR Code ou placa. O funcionamento interno do banco está fora do escopo"
		satisfied by EstacionamentoComponents.BancoDadosCP ;
	}
}

Requirement QualidadeNFR ( 2.0 ) {
	text = "O sistema deve atender aos requisitos de qualidade essenciais para sua operação contínua e confiável"

	Requirement DisponibilidadeNFR ( 2.1 ) {
		text = "O sistema deve operar continuamente, 24 horas por dia, 7 dias por semana"
	}

	Requirement DesempenhoNFR ( 2.2 ) {
		text = "Leitura de placa ou QR Code, consulta da sessão e registro de entrada/saída devem ser processados em até 2 segundos"
	}

	Requirement SegurancaNFR ( 2.3 ) {
		text = "O sistema deve usar QR Code único por sessão e revalidar o pagamento na saída, evitando reutilização de ticket e saída após a tolerância"
	}

	Requirement UsabilidadeNFR ( 2.4 ) {
		text = "A interface do totem deve ser simples e intuitiva para o usuário final"
	}

	Requirement ModularidadeNFR ( 2.5 ) {
		text = "A arquitetura deve ser organizada em módulos com interfaces explícitas, de forma que um módulo ou o banco de dados possam ser substituídos sem alterar os demais"
		satisfied by EstacionamentoModulos.SistemaEstacionamentoCP ;
	}
}